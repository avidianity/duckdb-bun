# Native libraries are fetched (`bun run fetch-lib`) or built (`bun run build:native`), never committed.
*.so
*.dylib
*.dll
*.a

node_modules/
*.log
.DS_Store

# compiled binaries / test artifacts
/dd
*.bin
tests/compile/*.out

# compiled proof binaries
dd
dd-neo

# Rust build output
/native/target/

# Claude Code worktrees and local state
/.claude/

# Benchmark output, written by `bun run bench`
/bench/results/

# Coverage reports, written by `bun run coverage`
/coverage/

# Soak reports, written by `bun run soak`
/soak-report/
