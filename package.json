{
  "name": "@avidian/duckdb-bun",
  "version": "2.0.0-r.0",
  "description": "Bun-native, drop-in reimplementation of @duckdb/node-api via bun:ffi over the libduckdb C API. Embeds libduckdb so `bun build --compile` yields a self-contained binary.",
  "author": "John Michael Manlupig",
  "license": "MIT",
  "homepage": "https://github.com/avidianity/duckdb-bun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avidianity/duckdb-bun.git"
  },
  "bugs": {
    "url": "https://github.com/avidianity/duckdb-bun/issues"
  },
  "type": "module",
  "module": "src/neo.ts",
  "types": "src/neo.ts",
  "exports": {
    ".": "./src/neo.ts",
    "./native-js": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "vendor/duckdb.h",
    "vendor/node-api/src",
    "vendor/node-api/LICENSE",
    "vendor/node-api/PROVENANCE.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fetch-lib": "bun run scripts/fetch-lib.ts",
    "build:native": "bun run scripts/build-native.ts",
    "spike": "bun run scripts/spike.ts",
    "bench": "bun run bench/main.ts",
    "test": "bun test",
    "test:official": "bun test tests/official/api.test.ts",
    "test:bindings": "bun test tests/official/bindings.test.ts",
    "parity": "bun test tests/parity.test.ts",
    "test:compile": "bun test tests/compile/compile.test.ts",
    "test:leak": "bun test tests/heavy/leak.test.ts",
    "test:stress": "bun test tests/heavy/event-loop-stress.test.ts",
    "test:crash": "bun test tests/heavy/crash-report.test.ts",
    "test:issue-3060": "bun test tests/heavy/issue-3060.test.ts",
    "test:unit": "bun test --path-ignore-patterns 'tests/official/**' --path-ignore-patterns 'tests/heavy/**' --path-ignore-patterns 'tests/compile/**' --path-ignore-patterns tests/parity.test.ts",
    "gen:bindings": "bun run scripts/gen-bindings-scaffold.ts",
    "build:neo": "bun run scripts/build-neo-compile.ts",
    "check-version": "bun run scripts/check-version.ts",
    "lint": "bun --bun biome check src tests scripts examples bench commitlint.config.ts",
    "lint:ci": "bun --bun biome ci src tests scripts examples bench commitlint.config.ts",
    "format": "bun --bun biome format --write src tests scripts examples bench commitlint.config.ts",
    "typecheck": "bun check --no-script src/bindings/next.ts src/bindings/api src/bindings/runtime src/bindings/generated src/library.ts tests/runtime tests/heavy/crash-report.test.ts tests/heavy/fixtures/crash-child.ts tests/vitest-shim.ts tests/preload.ts tests/node-bindings-resolve.ts scripts/gen-ffi.ts scripts/gen-contract.ts scripts/vendor-api-spec.ts scripts/check-version.ts scripts/build-native.ts commitlint.config.ts",
    "check": "bun run lint && bun check",
    "gen:ffi": "bun run scripts/gen-ffi.ts",
    "vendor:api-spec": "bun run scripts/vendor-api-spec.ts",
    "gen:contract": "bun run scripts/gen-contract.ts"
  },
  "keywords": [
    "duckdb",
    "bun",
    "ffi",
    "sql",
    "analytics"
  ],
  "optionalDependencies": {
    "@avidian/duckdb-bun-darwin-arm64": "2.0.0-r.0",
    "@avidian/duckdb-bun-linux-x64": "2.0.0-r.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/bun": "1.4.4",
    "@types/chai": "5.2.3",
    "chai": "6.3.0",
    "lefthook": "2.2.2"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
