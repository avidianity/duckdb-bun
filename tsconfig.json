{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      // For type checking only: the vendored suites import `vitest`, which is not
      // installed. At run time tests/preload.ts rewrites that import to the shim.
      "vitest": ["./tests/vitest-shim.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "examples", "vendor/node-api"]
}
