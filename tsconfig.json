{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    // Every file is transpilable on its own, as Bun runs it, and a type-only import
    // says so; Biome's useImportType fixes the imports this flags.
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src", "tests", "scripts", "examples", "bench", "vendor", "commitlint.config.ts"]
}
