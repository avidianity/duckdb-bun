{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/vendor/**", "!src/api/**", "!tests/api/**", "!tests/bindings/**", "!src/bindings/node-bindings.d.ts", "!bench/results/**", "!**/*.so", "!**/*.dylib", "!**/*.dll"]
  }
}
