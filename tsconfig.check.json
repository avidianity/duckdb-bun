{
  // The type check only (`bun run typecheck`). These aliases must never apply at run time: Bun applies
  // tsconfig.json `paths` to every import, including the official @duckdb/node-api's own
  // `require("@duckdb/node-bindings")`, which would then load our bindings and make every comparison
  // with the official package compare ours with ours.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      // The vendored suites import `vitest`, which is not installed. At run time tests/preload.ts
      // rewrites that import to the shim.
      "vitest": ["./tests/vitest-shim.ts"],
      // The vendored suites import the bindings by package name; at run time tests/preload.ts and
      // tests/node-bindings-resolve.ts point those imports, and only those, at src/bindings/.
      "@duckdb/node-bindings": ["./src/bindings/index.ts"]
    }
  }
}
